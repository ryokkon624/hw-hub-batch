<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "https://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<generatorConfiguration>

    <!-- Context: MySQL -->
    <context id="MySQLTables" targetRuntime="MyBatis3" defaultModelType="flat">
        <property name="javaFileEncoding" value="UTF-8"/>

        <!-- enableSelectByExample → selectAllをExampleで実現するためtrue -->
        <property name="autoDelimitKeywords" value="true"/>
        <property name="beginningDelimiter" value="`"/>
        <property name="endingDelimiter" value="`"/>

        <!-- コメント必要ないので抑止 -->
        <commentGenerator>
            <property name="suppressAllComments" value="true"/>
            <property name="suppressDate" value="true"/>
        </commentGenerator>

        <!-- DB接続 -->
        <jdbcConnection
                driverClass="com.mysql.cj.jdbc.Driver"
                connectionURL="jdbc:mysql://localhost:3306/hwhub_db?useUnicode=true&amp;characterEncoding=UTF-8&amp;serverTimezone=Asia/Tokyo"
                userId="hwhub"
                password="hwhub">
        </jdbcConnection>

        <!-- Java型マッピング -->
        <javaTypeResolver>
            <property name="forceBigDecimals" value="false"/>
        </javaTypeResolver>

        <!-- 出力先：domain：MBG生成のEntityは infrastructure 配下に -->
        <javaModelGenerator targetPackage="com.hwhub.batch.infrastructure.mybatis.generated.entity"
                            targetProject="src/main/java">
            <property name="trimStrings" value="true"/>
        </javaModelGenerator>

        <!-- ★ DTD の順番どおりに sqlMap → javaClient の順にする -->

        <!-- 出力先：Mapper XML -->
        <sqlMapGenerator targetPackage="mapper.generated"
                         targetProject="src/main/resources">
        </sqlMapGenerator>

        <!-- 出力先：Mapperインタフェース（生成物） -->
        <javaClientGenerator type="XMLMAPPER"
                             targetPackage="com.hwhub.batch.infrastructure.mybatis.generated.mapper"
                             targetProject="src/main/java">
        </javaClientGenerator>

        <!-- テーブル追加した場合は、SQLを発行して結果を張り付けてください -->
        <!--
            SELECT
                concat(
                    '<table tableName="'
                    , t.table_name
                    , '" '
                    , 'enableCountByExample="false" '
                    , 'enableUpdateByExample="false" '
                    , 'enableDeleteByExample="false" '
                    , 'enableSelectByExample="true" '
                    , 'selectByExampleQueryId="false">'
                    , CASE
                        WHEN pk.column_name IS NOT NULL
                            THEN concat(
                            '<generatedKey column="'
                            , pk.column_name
                            , '" sqlStatement="JDBC" identity="true"/>'
                        )
                        ELSE ''
                        END
                    , '</table>'
                ) AS mbg_table_def
            FROM
                information_schema.tables t
                LEFT JOIN (
                    SELECT
                        table_schema
                        , table_name
                        , column_name
                    FROM
                        information_schema.columns
                    WHERE
                        table_schema = 'hwhub_db'
                        AND extra LIKE '%auto_increment%'
                        AND column_key = 'PRI'
                ) pk
                    ON pk.table_schema = t.table_schema
                    AND pk.table_name = t.table_name
            WHERE
                t.table_schema = 'hwhub_db'
                AND (
                    t.table_name LIKE 'm\_%' ESCAPE '\\'
                    OR t.table_name LIKE 't\_%' ESCAPE '\\'
                )
            ORDER BY
                t.table_name;
         -->
        <table tableName="m_announcement" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"><generatedKey column="announcement_id" sqlStatement="JDBC" identity="true"/></table>
        <table tableName="m_code" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"></table>
        <table tableName="m_household" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"><generatedKey column="household_id" sqlStatement="JDBC" identity="true"/></table>
        <table tableName="m_household_member" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"></table>
        <table tableName="m_housework" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"><generatedKey column="housework_id" sqlStatement="JDBC" identity="true"/></table>
        <table tableName="m_housework_template" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"><generatedKey column="housework_template_id" sqlStatement="JDBC" identity="true"/></table>
        <table tableName="m_user" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"><generatedKey column="user_id" sqlStatement="JDBC" identity="true"/></table>
        <table tableName="m_user_notification_setting" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"></table>
        <table tableName="t_household_invitation" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"></table>
        <table tableName="t_housework_task" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"><generatedKey column="housework_task_id" sqlStatement="JDBC" identity="true"/></table>
        <table tableName="t_housework_task_assignment_history" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"><generatedKey column="housework_task_assignment_history_id" sqlStatement="JDBC" identity="true"/></table>
        <table tableName="t_housework_task_recalc_request" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"><generatedKey column="request_id" sqlStatement="JDBC" identity="true"/></table>
        <table tableName="t_inquiry" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"><generatedKey column="inquiry_id" sqlStatement="JDBC" identity="true"/></table>
        <table tableName="t_inquiry_message" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"><generatedKey column="message_id" sqlStatement="JDBC" identity="true"/></table>
        <table tableName="t_notification" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"><generatedKey column="notification_id" sqlStatement="JDBC" identity="true"/></table>
        <table tableName="t_notification_event" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"><generatedKey column="notification_event_id" sqlStatement="JDBC" identity="true"/></table>
        <table tableName="t_shopping_item" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"><generatedKey column="shopping_item_id" sqlStatement="JDBC" identity="true"/></table>
        <table tableName="t_shopping_item_attachment" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"><generatedKey column="shopping_item_attachment_id" sqlStatement="JDBC" identity="true"/></table>
        <table tableName="t_user_email_verification" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"><generatedKey column="user_email_verification_id" sqlStatement="JDBC" identity="true"/></table>
        <table tableName="t_user_password_reset" enableCountByExample="false" enableUpdateByExample="false" enableDeleteByExample="false" enableSelectByExample="true" selectByExampleQueryId="false"><generatedKey column="user_password_reset_id" sqlStatement="JDBC" identity="true"/></table>

    </context>
</generatorConfiguration>
