<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hwhub.batch.infrastructure.mybatis.custom.mapper.HouseworkCustomMapper">

    <resultMap id="HouseworkResultMap" type="com.hwhub.batch.domain.model.Housework">
        <id     property="houseworkId"          column="housework_id"/>
        <result property="householdId"          column="household_id"/>
        <result property="name"                 column="name"/>
        <result property="description"          column="description"/>
        <result property="category"             column="category"/>
        <result property="recurrenceTypeCode"   column="recurrence_type"/>
        <result property="weeklyDays"           column="weekly_days"/>
        <result property="dayOfMonth"           column="day_of_month"/>
        <result property="nthWeek"              column="nth_week"/>
        <result property="weekday"              column="weekday"/>
        <result property="startDate"            column="start_date"/>
        <result property="endDate"              column="end_date"/>
        <result property="defaultAssigneeUserId" column="default_assignee_user_id"/>
    </resultMap>

    <!-- 有効期間が fromDate〜toDate と交差する housework を取得 -->
    <select id="selectActiveHousework" resultMap="HouseworkResultMap">
        SELECT
        housework_id
        , household_id
        , name
        , description
        , category
        , recurrence_type
        , weekly_days
        , day_of_month
        , nth_week
        , weekday
        , start_date
        , end_date
        , default_assignee_user_id
        FROM
        m_housework
        WHERE
        start_date &lt;= #{toDate}
        AND end_date &gt;= #{fromDate}
    </select>
</mapper>
