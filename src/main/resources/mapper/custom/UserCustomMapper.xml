<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hwhub.batch.infrastructure.mybatis.custom.mapper.UserCustomMapper">

    <select id="findByIds"
            resultMap="com.hwhub.batch.infrastructure.mybatis.generated.mapper.MUserMapper.BaseResultMap">
        SELECT
            user_id
            , email
            , password_hash
            , password_changed_at
            , auth_provider
            , auth_provider_id
            , display_name
            , profile_image_key
            , locale
            , email_verified_at
            , is_active
            , create_user_id
            , create_program
            , created_at
            , update_user_id
            , update_program
            , updated_at 
        FROM m_user
        WHERE user_id IN
        <foreach collection="userIds"
                item="id"
                open="("
                separator=","
                close=")">
            (#{id})
        </foreach>
    </select>
    
</mapper>
