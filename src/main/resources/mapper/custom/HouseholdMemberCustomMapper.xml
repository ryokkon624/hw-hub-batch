<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hwhub.batch.infrastructure.mybatis.custom.mapper.HouseholdMemberCustomMapper">

    <select id="findByHouseholdAndUserPairs"
            resultMap="com.hwhub.batch.infrastructure.mybatis.generated.mapper.MHouseholdMemberMapper.BaseResultMap">
            SELECT
                household_id
                , user_id
                , nickname
                , status
                , create_user_id
                , create_program
                , created_at
                , update_user_id
                , update_program
                , updated_at
            FROM
                m_household_member
            WHERE
                (household_id, user_id) IN 
            <foreach collection="pairs"
                item="p"
                open="("
                separator=","
                close=")">
            (#{p.householdId}, #{p.userId})
        </foreach>
    </select>

</mapper>
